# Everest School Management System - Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# Django Core
SECRET_KEY=django-insecure-change-me-before-deploying-to-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (leave DB_ENGINE as sqlite3 for local dev; change to postgresql for production)
DB_ENGINE=django.db.backends.sqlite3
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=everest_school
# DB_USER=postgres
# DB_PASSWORD=yourpassword
# DB_HOST=localhost
# DB_PORT=5432

# CORS (Vite frontend dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=True
